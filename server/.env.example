# DockerServer configuration. Copy to .env (same directory) and edit:
#   cp .env.example .env && chmod 600 .env
# The app reads .env itself at startup (DOCKERSERVER_ENV_FILE overrides the path); values in
# .env override inherited environment variables. .env is git-ignored: secrets go ONLY there.

# ---- storage / images ----
# relative paths are resolved against this directory
DOCKERSERVER_DATA_DIR=data
DOCKERSERVER_DEFAULT_IMAGE=python:3.12-slim
DOCKERSERVER_ALLOWED_IMAGES=python:3.12-slim
#DOCKERSERVER_MAX_UPLOAD_BYTES=52428800
#DOCKERSERVER_MAX_LOG_BYTES=1048576

# ---- credits ----
DOCKERSERVER_DEFAULT_CREDIT_HOURS=1000
DOCKERSERVER_MONITOR_INTERVAL=10
#DOCKERSERVER_MIN_START_SECONDS=60

# ---- limits for newly created users (existing users keep theirs) ----
DOCKERSERVER_DEFAULT_MAX_CPUS=1
DOCKERSERVER_DEFAULT_MAX_MEM_MB=256
DOCKERSERVER_DEFAULT_MAX_RUN_SECONDS=600
DOCKERSERVER_DEFAULT_MAX_CONCURRENT_JOBS=2

# ---- public access / security ----
# Host headers accepted by /mcp and /mcp-admin (DNS-rebinding protection).
DOCKERSERVER_ALLOWED_HOSTS=127.0.0.1:8800,localhost:8800,compute.llmfreedomforge.com
# More than AUTH_FAIL_LIMIT bad tokens from one client IP within AUTH_FAIL_WINDOW s -> HTTP 429.
DOCKERSERVER_AUTH_FAIL_LIMIT=20
DOCKERSERVER_AUTH_FAIL_WINDOW=300

# ---- OAuth for MCP custom connectors (claude.ai / Claude Desktop) ----
DOCKERSERVER_PUBLIC_URL=https://compute.llmfreedomforge.com
#DOCKERSERVER_OAUTH=true
#DOCKERSERVER_OAUTH_REDIRECT_HOSTS=claude.ai,claude.com
#DOCKERSERVER_OAUTH_ACCESS_TTL=3600
#DOCKERSERVER_OAUTH_REFRESH_TTL=2592000

# ---- users' environment variables ----
# Fernet key that encrypts stored variables. Generated and appended here on first start if missing.
# Back it up with this file: without it, stored variables can't be decrypted.
#DOCKERSERVER_SECRET_KEY=

# ---- compute nodes (jobs run there instead of on this host) ----
# JSON list in single quotes; each token is read from the variable named by token_env.
# A node whose token is empty is skipped; with no usable node, jobs run on this host's Docker.
DOCKERSERVER_NODES='[{"name":"mini","url":"http://100.126.20.127:8900","token_env":"DOCKERSERVER_NODE_TOKEN_MINI"}]'
DOCKERSERVER_NODE_TOKEN_MINI=
# Also use this host's Docker as a fallback (default: only when no node is usable).
#DOCKERSERVER_LOCAL_EXECUTION=false
#DOCKERSERVER_NODE_LOST_GRACE=120
#DOCKERSERVER_QUEUE_TIMEOUT=3600
#DOCKERSERVER_QUEUE_RETRY=5
#DOCKERSERVER_NODE_INFO_TTL=5
#DOCKERSERVER_NODE_POLL_INTERVAL=2
