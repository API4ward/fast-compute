# Caddy site config for DockerServer. Edit HERE (in the project); /etc/caddy/Caddyfile only
# contains:  import /home/ubuntu/projects/dockerserver/deploy/Caddyfile
# Apply changes with:  sudo systemctl reload caddy
#
# DockerServer listens on 127.0.0.1:8800 only; Caddy terminates HTTPS (automatic certificate)
# and reverse-proxies to it. The domain is proxied by Cloudflare (orange cloud), so Cloudflare's
# edge ranges are trusted and the real visitor IP is taken from CF-Connecting-IP.
# Ranges from https://www.cloudflare.com/ips-v4 and /ips-v6 (fetched 2026-11-11; re-check now
# and then). If you stop using Cloudflare's proxy, delete the trusted_proxies/client_ip_headers lines.

{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

compute.llmfreedomforge.com {
	encode gzip
	request_body {
		# uploads are capped at 50 MB by the app; allow multipart overhead
		max_size 60MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Host header is passed through unchanged. X-Forwarded-For carries exactly the visitor IP,
	# trusted by uvicorn (--proxy-headers --forwarded-allow-ips=127.0.0.1).
	reverse_proxy 127.0.0.1:8800 {
		header_up X-Forwarded-For {client_ip}
		# long-running MCP calls (submit_job wait up to 60 s)
		transport http {
			read_timeout 120s
		}
	}
}
