# Install as /etc/dockerserver.env (read by the systemd unit).
DOCKERSERVER_DATA_DIR=/home/ubuntu/projects/dockerserver/data
DOCKERSERVER_DEFAULT_IMAGE=python:3.12-slim
DOCKERSERVER_ALLOWED_IMAGES=python:3.12-slim
DOCKERSERVER_DEFAULT_CREDIT_HOURS=1000
DOCKERSERVER_MONITOR_INTERVAL=10
# Host headers accepted by /mcp (DNS-rebinding protection); add any new public hostname here.
DOCKERSERVER_ALLOWED_HOSTS=127.0.0.1:8800,localhost:8800,compute.llmfreedomforge.com
# More than AUTH_FAIL_LIMIT bad tokens from one client IP within AUTH_FAIL_WINDOW s -> HTTP 429.
DOCKERSERVER_AUTH_FAIL_LIMIT=20
DOCKERSERVER_AUTH_FAIL_WINDOW=300
