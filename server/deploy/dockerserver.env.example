# Install as /etc/dockerserver.env (read by the systemd unit).
DOCKERSERVER_DATA_DIR=/home/ubuntu/projects/dockerserver/data
DOCKERSERVER_DEFAULT_IMAGE=python:3.12-slim
DOCKERSERVER_ALLOWED_IMAGES=python:3.12-slim
DOCKERSERVER_DEFAULT_CREDIT_HOURS=1000
DOCKERSERVER_MONITOR_INTERVAL=10
# Host headers accepted by /mcp (DNS-rebinding protection); add any new public hostname here.
DOCKERSERVER_ALLOWED_HOSTS=127.0.0.1:8800,localhost:8800,compute.llmfreedomforge.com
# More than AUTH_FAIL_LIMIT bad tokens from one client IP within AUTH_FAIL_WINDOW s -> HTTP 429.
DOCKERSERVER_AUTH_FAIL_LIMIT=20
DOCKERSERVER_AUTH_FAIL_WINDOW=300

# ---- Compute nodes (jobs run there instead of on this host) ----
# JSON list; each node's token is read from the env var named by token_env (keep tokens ONLY
# in this file, chmod 640 root:ubuntu - never in git). Without a usable node, jobs run locally.
#DOCKERSERVER_NODES='[{"name":"mini","url":"http://100.126.20.127:8900","token_env":"DOCKERSERVER_NODE_TOKEN_MINI"}]'
#DOCKERSERVER_NODE_TOKEN_MINI=paste-the-node-token-here
# Run jobs on this host's Docker too (default: only when no node is configured).
#DOCKERSERVER_LOCAL_EXECUTION=false
#DOCKERSERVER_NODE_LOST_GRACE=120
#DOCKERSERVER_QUEUE_TIMEOUT=3600
# Limits for newly created users (existing users are not changed).
DOCKERSERVER_DEFAULT_MAX_CPUS=1
DOCKERSERVER_DEFAULT_MAX_MEM_MB=256
DOCKERSERVER_DEFAULT_MAX_RUN_SECONDS=600
DOCKERSERVER_DEFAULT_MAX_CONCURRENT_JOBS=2
